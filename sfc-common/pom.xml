<?xml version="1.0" encoding="UTF-8"?>
<!--
    微服务与宿主共用的「轻量共享库」。

    ⚠️ 位置变更说明（Phase 1）：本模块原先位于 `microservices/sfc-common` 并由 `microservices/pom.xml`
    聚合；为使宿主（sfc-api → sfc-core 等）也能复用同一份常量 / 信封 / 异常 / 工具 / 分页模型，
    已上提到**仓库根目录**，并改为不继承任何 parent 的独立模块。

    刻意【不继承】仓库根 pom，也【不再继承】microservices/pom.xml：
      - 继承根 pom：根 pom 在 <dependencies>（而非 <dependencyManagement>）中声明了
        JPA / Security / Redis / Netty 等整套技术栈，会被无条件继承（实测 208 个 jar），
        "轻量共享" 当场不成立；
      - 继承 microservices/pom.xml：会让这个同时服务宿主的模块带上微服务的构建约定与版本矩阵。
    因此本模块自带全部构建配置（同类写法见 sfc-auth、sfc-common-data，它们同样无 parent）。

    编译基线取统一的 spring-boot-dependencies 4.0.8（与 core / microservices 两端一致）：
    只用两端都存在的稳定 API，编译基线不高于运行侧即为兼容方向（与 sfc-auth 的既有约定一致）。

    ⚠️ 本模块必须保持「零 JPA」：网关（WebFlux，无 JPA）也依赖本模块，
    一旦非可选地引入 JPA/Hibernate，会把它泄漏给网关。数据访问基座在 sfc-common-data。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sfc.cloud</groupId>
    <artifactId>sfc-common</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>sfc-common</name>
    <description>共享轻量库：常量、响应信封、异常、字符串/JSON 工具、分页模型、身份凭证解析与信任头</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                仅导入 BOM 用于管理 spring / jakarta / slf4j / lombok 的版本，不引入任何实际依赖。
                dependencyManagement 不具备传递性，因此不影响本模块的消费者。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.0.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- MapperHolder / SfcJsonResult / 凭证载荷的 JSON 处理 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- SecureUtils（Reactive ServerHttpRequest）与 SfcStringUtils 的 @Nullable -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- JWT：api 编译期引用，impl / jackson 是纯运行期实现（Jwts 经 ServiceLoader 装载） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!--
            SfcPageInfo.of(Page) 需要 Page 类型。
            以 provided 声明：不传递给消费方（网关等无 JPA/Spring Data 的消费方不会被污染），
            只有真正调用 of(Page) 的消费方（宿主与自带数据库的微服务）才需要自行提供。
        -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-commons</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                因不继承 parent，编译相关配置需全部显式声明：
                proc=full 用于在 JDK 23+ 下启用 classpath 中的注解处理器，否则 lombok 不生效；
                release / encoding 用于确定编译目标版本与源码编码（本模块含中文注释与中文响应消息）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <proc>full</proc>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
