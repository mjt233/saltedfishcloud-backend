<?xml version="1.0" encoding="UTF-8"?>
<!--
    微服务与宿主共用的「数据访问基座」模块。

    刻意【不继承】仓库根 pom：根 pom 在 <dependencies>（而非 <dependencyManagement>）中声明了
    JPA / Security / Redis / Netty 等整套技术栈，会被所有子模块无条件继承（实测 208 个 jar）。
    本模块同时被宿主（sfc-api → sfc-core 等）与微服务侧（自带数据库的服务）使用，一旦继承根 pom，
    微服务侧会被拖入同一套技术栈。因此本模块自带全部构建配置（同类写法见 sfc-common / sfc-auth，
    它们同样未声明 parent）。

    ⚠️ 与 sfc-common 的分工：
      - sfc-common      —— 零 JPA 的轻量共享库（常量 / 信封 / 异常 / 工具 / 分页 / 远程契约）；
      - sfc-common-data —— 本模块，在 sfc-common 之上叠加 JPA 与 Spring Data 基座。

    ⚠️ 依赖作用域策略：
      - JPA / Spring Data / Spring JDBC 是本模块类的语义基础（离开它们这些类无法使用），
        故以 compile 作用域声明，让消费方开箱即用；
      - 但只依赖具体构件而非 starter，避免把整套自动配置带进消费方；
      - Hibernate 与 jakarta.validation 属于「运行期由消费方提供」的规范性实现，
        按仓库既有范式以 provided 声明（不传递，避免版本污染）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sfc.cloud</groupId>
    <artifactId>sfc-common-data</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>sfc-common-data</name>
    <description>共享数据访问基座：实体基类、雪花ID、BaseRepo、CrudService、批量DB工具与UID权限校验</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            共享库版本。与 microservices/pom.xml 的 common.version、根 pom 的 cloud.version 保持一致口径。
        -->
        <sfc.common.version>1.0.0</sfc.common.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--
                仅导入 BOM 用于管理 spring / jakarta / slf4j / lombok 的版本，不引入任何实际依赖。
                dependencyManagement 不具备传递性，因此不影响本模块的消费者。
                编译基线取 microservices 侧的 4.0.8（低于 core 的 4.1.0）：只用两端都存在的稳定 API，
                编译基线不高于运行侧即为兼容方向（同 sfc-auth 的既有约定）。
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>4.0.8</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 轻量共享库：常量、信封、异常、工具与分页 -->
        <dependency>
            <groupId>com.sfc.cloud</groupId>
            <artifactId>sfc-common</artifactId>
            <version>${sfc.common.version}</version>
        </dependency>

        <!-- Spring Data JPA：JpaRepository / JpaSpecificationExecutor / Specification / Page / Pageable / Auditing -->
        <dependency>
            <groupId>org.springframework.data</groupId>
            <artifactId>spring-data-jpa</artifactId>
        </dependency>
        <!-- JdbcTemplate 与批量写入 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>
        <!-- 事务模板与 PlatformTransactionManager -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- @Autowired 等注解 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-beans</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>

        <!-- JPA 注解：@Id / @Column / @MappedSuperclass / @Transient / @EntityListeners -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!-- 以下运行期一律由消费方提供：provided 不传递，避免污染消费方 -->
        <!-- Hibernate 的 IdentifierGenerator SPI：雪花主键生成器用 -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @SfcUID 的 Bean Validation 约束 -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- @Nullable / @NotNull -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <!--
                ⚠️ 必须显式写版本：spring-boot-dependencies 4.0.8 与 4.1.0 的 BOM
                都**没有**管理 org.jetbrains:annotations（它们只管理 org.jetbrains.kotlin*）。
                provided 作用域 → 不传递，对消费方零污染。
            -->
            <version>26.0.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                因不继承 parent，编译相关配置需全部显式声明：
                proc=full 用于在 JDK 23+ 下启用 classpath 中的注解处理器，否则 lombok 不生效；
                release / encoding 用于确定编译目标版本与源码编码（本模块含中文注释）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <proc>full</proc>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
