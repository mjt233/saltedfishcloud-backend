<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>saltedfishcloud</artifactId>
        <groupId>com.xiaotao</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>sfc-core</artifactId>
    <properties>
        <maven.build.timestamp.format>yyyyMMddHHmmss</maven.build.timestamp.format>
    </properties>

    <profiles>
        <profile>
            <id>develop</id>
            <properties>
                <spring-profile>develop</spring-profile>
            </properties>
        </profile>
        <profile>
            <id>develop-mysql</id>
            <properties>
                <spring-profile>develop-mysql</spring-profile>
            </properties>
        </profile>
        <profile>
            <id>frontend-resource</id>
            <activation>
                <property>
                    <name>env.SFC_FRONT_END_PATH</name>
                </property>
            </activation>
            <properties>
                <sfc.front-end-path>${env.SFC_FRONT_END_PATH}</sfc.front-end-path>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <!--    打包前复制前端项目编译结果    -->
                            <execution>
                                <id>copy-frontend</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <echo message="复制前端项目: ${sfc.front-end-path}" />
                                        <!-- 复制到输出目录-->
                                        <copy overwrite="true" todir="${project.build.outputDirectory}/webapp">
                                            <fileset dir="${sfc.front-end-path}/dist" includes="**"/>
                                        </copy>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>product</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring-profile>product</spring-profile>
            </properties>
        </profile>
    </profiles>
    <dependencies>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-api</artifactId>
            <version>${api.version}</version>
        </dependency>
        <!--  微服务契约模块（服务注册与发现 SPI）。瘦契约：自身只依赖 provided 的 lombok，不引入额外技术栈  -->
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-cloud-api</artifactId>
            <version>${cloud.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-task-api</artifactId>
            <version>${task.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-task-core</artifactId>
            <version>${task.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-rpc-core</artifactId>
            <version>${rpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.xiaotao</groupId>
            <artifactId>sfc-archive-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
            指标实现（版本由 spring-boot-dependencies BOM 管理）。

            为什么宿主需要它：nacos-client 的 naming 主路径依赖 io.micrometer.core.instrument.MeterRegistry
            （com.alibaba.nacos.client.naming.cache.ServiceInfoHolder 构造时即触达）。
            而宿主原本只有 micrometer-observation / micrometer-commons，于是 spring-boot-tomcat、spring-boot-webmvc、
            spring-boot-jdbc、spring-boot-hibernate、spring-boot-data-commons 里那些
            @ConditionalOnClass(MeterRegistry.class) 的自动配置长期处于"有条件但类不可加载"的临界状态：
            它们本应被跳过，只是一直没有东西把 MeterRegistry 摆到合并类加载器上。

            sfc-ext-nacos 插件一旦把 micrometer-core 带进插件依赖，条件判定（走能看到插件 jar 的加载器）就会通过，
            而这些自动配置类自身由 AppClassLoader 定义、解析方法签名时又找不到 MeterRegistry，启动直接失败：
                NoClassDefFoundError: io/micrometer/core/instrument/MeterRegistry
                ... TomcatMetricsAutoConfiguration (Lookup method resolution failed)

            因此由宿主显式提供一份，插件侧则排除同名 jar（见 sfc-ext-nacos/pom.xml），保证全局只有一份且可被宿主加载器解析。
            注：宿主没有 spring-boot-starter-actuator，不会创建 MeterRegistry Bean，
            上述自动配置的方法级 @ConditionalOnBean(MeterRegistry.class) 仍会失败并跳过，故不引入额外的指标行为。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>



        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-authorization-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/config</directory>
                <filtering>true</filtering>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
                <configuration>
                    <delimiters>
                        <delimiter>^*^</delimiter>
                    </delimiters>
                    <useDefaultDelimiters>false</useDefaultDelimiters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <!--    创建release资源    -->
                    <execution>
                        <id>package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${basedir}/../release/ext" />
                                <mkdir dir="${basedir}/../release/ext-available" />
                                <copy overwrite="true" todir="${basedir}/../release">
                                    <fileset dir="${basedir}/../pre-release" includes="**"/>
                                </copy>
                                <copy
                                        overwrite="true"
                                        tofile="${basedir}/../release/sfc-core.jar"
                                        file="${project.build.directory}/${project.artifactId}-${project.version}.jar"
                                />
                                <copy
                                        overwrite="true"
                                        tofile="${basedir}/../release/README.md"
                                        file="${basedir}/../README.md"
                                />
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
