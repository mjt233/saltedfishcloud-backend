<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>sfc-ext</artifactId>
        <groupId>com.xiaotao</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <version>${revision}</version>
    <artifactId>sfc-ext-nacos</artifactId>

    <properties>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
    </properties>

    <dependencies>
        <!--
            Nacos 注册中心客户端。版本与服务端镜像保持一致（nacos-server:latest = 3.2.4）。

            Nacos 3.x 的客户端形态已变化：nacos-client-3.2.4.jar 是一个 14MB / 5311 类的自包含 fat jar
            （grpc / protobuf / netty / jackson 等已 relocate 到 com.alibaba.nacos 之下），
            因此 grpc / protobuf / guava / netty 完全不参与宿主冲突比对，冲突面只剩下列通用基础设施。

            下列 <exclusions> 的依据是实测的宿主依赖清单（sfc-core/target/host-deps.txt）：
            父模块 sfc-ext 导入了 spring-boot-dependencies:4.1.0 BOM，它已把 nacos 声明的版本
            对齐到与宿主【完全相同】的版本（见各条注释的实测值）。因此这些 jar 即使保留，
            也会被插件系统判为「完全重复(无害)」而静默跳过——排除与不排除的运行期类路径完全一致；
            排除的目的是得到零告警的启动日志，并消除"宿主版本变化后退化为类级冲突"的隐患。
        -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
            <version>3.2.4</version>
            <exclusions>
                <!-- JSON：宿主 com.fasterxml.jackson.core:jackson-databind / jackson-core 2.21.4 -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-databind</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-core</artifactId>
                </exclusion>
                <!-- jackson-databind 的传递依赖：宿主 jackson-annotations 2.21 -->
                <exclusion>
                    <groupId>com.fasterxml.jackson.core</groupId>
                    <artifactId>jackson-annotations</artifactId>
                </exclusion>
                <!-- YAML：宿主 org.yaml:snakeyaml 2.6 -->
                <exclusion>
                    <groupId>org.yaml</groupId>
                    <artifactId>snakeyaml</artifactId>
                </exclusion>
                <!-- 日志门面：宿主 org.slf4j:slf4j-api 2.0.18 -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-api</artifactId>
                </exclusion>
                <!-- IO 工具：宿主 commons-io:commons-io 2.20.0 -->
                <exclusion>
                    <groupId>commons-io</groupId>
                    <artifactId>commons-io</artifactId>
                </exclusion>
                <!-- 指标：宿主 io.micrometer:micrometer-commons / micrometer-observation 1.17.0 -->
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-commons</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-observation</artifactId>
                </exclusion>
                <!--
                    指标实现：由【宿主 sfc-core】显式提供（见 sfc-core/pom.xml 中的同名依赖），这里是纯粹的"全局只留一份"。

                    反面教训（实测）：不要试图在插件里排除它。nacos-client 的 naming 主路径
                    （ServiceInfoHolder -> FailoverReactor）真的需要 MeterRegistry，排除后创建 NamingService 时即抛
                        NoClassDefFoundError: io/micrometer/core/instrument/MeterRegistry

                    正面理由：宿主有 5 个自动配置类以 @ConditionalOnClass(MeterRegistry.class) 为开关
                    （TomcatMetricsAutoConfiguration、WebMvcObservationAutoConfiguration$MeterFilterConfiguration、
                    DataSourcePoolMetricsAutoConfiguration、HibernateMetricsAutoConfiguration、
                    DataRepositoryMetricsAutoConfiguration）。只要插件把 micrometer-core 摆到合并类加载器上，
                    这些条件就会通过，而它们自身由 AppClassLoader 定义、解析方法签名时又找不到该类，启动直接失败：
                        Lookup method resolution failed ... TomcatMetricsAutoConfiguration

                    即"宿主提供 + 插件排除"：宿主侧可加载 → 自动配置内省正常；插件侧不重复 → 无「完全重复」告警，
                    也不再把 MeterRegistry 暴露给宿主条件判定。
                -->
                <exclusion>
                    <groupId>io.micrometer</groupId>
                    <artifactId>micrometer-core</artifactId>
                </exclusion>
                <!-- 空值注解：宿主 org.jspecify:jspecify 1.0.0（已加载的 sfc-ext-mcp 也带同名同版本 jar） -->
                <exclusion>
                    <groupId>org.jspecify</groupId>
                    <artifactId>jspecify</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

</project>
