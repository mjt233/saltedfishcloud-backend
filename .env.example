# Maven 镜像（网络受限时使用，如阿里云）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# 数据库
MYSQL_ROOT_PASSWORD=your-password
MYSQL_DATABASE=xyy
# 必填：JWT 会话密钥，必须恰好 32 个字符（可用 `openssl rand -hex 16` 生成）
SFC_JWT_SECRET=0123456789abcdef0123456789abcdef
# 必填：服务间内部接口共享密钥，不少于 32 个字符（可用 `openssl rand -hex 16` 生成）
SFC_INTERNAL_KEY=0123456789abcdef0123456789abcdef

# accessToken 签名密钥：Base64 编码且解码后不少于 32 字节（可用 `openssl rand -base64 32` 生成），
# 集群部署时各节点必须一致；留空则使用 docker-compose 内置的调试默认值，生产环境必须自行生成并填写。
NACOS_AUTH_TOKEN=

# 服务端节点间身份识别 key/value（集群部署各节点需一致）；留空则使用 docker-compose 内置的调试默认值，生产环境请替换。
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# Nacos 管理员账号：用户名默认为 nacos；密码为首次访问 Nacos 控制台（宿主机 8080）时初始化的密码，
#   没有默认值，必须填写为实际值，否则服务注册会因鉴权失败而中断启动。
NACOS_USERNAME=nacos
NACOS_PASSWORD=your-nacos-admin-password

# aria2 RPC 令牌：需与下载服务 SFC_DOWNLOAD_ARIA2_SECRET 一致，并等于 aria2c 的 --rpc-secret；
#   留空则使用 docker-compose 内置的开发默认值，生产环境必须覆盖为强随机值（且不要提交明文）。
ARIA2_RPC_SECRET=
